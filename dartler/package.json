{
  "name": "dartler",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "images:import": "tsx --env-file=.env scripts/import-product-images.ts",
    "test": "tsx --test tests/pricing.test.ts",
    "test:e2e": "tsx --test tests/checkout.integration.test.ts",
    "test:all": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/playfair-display": "^5.1.1",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "jose": "5.9.6",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.5.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "^0.30.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.49.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}