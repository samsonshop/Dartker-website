# ---------------------------------------------------------------- core
# Postgres connection string. Works with a local Postgres, Supabase or any
# managed provider — nothing else in the codebase changes.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dartler?schema=public"

# Public origin of the storefront, used for canonical URLs, sitemap and
# absolute links inside emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 32+ character secret used to sign session cookies (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------- payments
# Razorpay. Only the key id is ever sent to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------- shipping
# Delhivery. Server-side only — never expose this token to the browser.
DELHIVERY_API_TOKEN=""
DELHIVERY_BASE_URL="https://staging-express.delhivery.com"
DELHIVERY_PICKUP_NAME=""
DELHIVERY_CLIENT_NAME=""
# Set to "true" to force the built-in mock courier even when a token exists.
DELHIVERY_USE_MOCK="true"

# ---------------------------------------------------------------- storage
# "local" writes to /public/uploads. Swap to "s3" or "supabase" later.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="dartler"

# ---------------------------------------------------------------- email
# SMTP account used to send transactional email (password reset codes).
# Works with any provider: Gmail / Google Workspace (smtp.gmail.com, app
# password), Zoho (smtp.zoho.in), Amazon SES, Resend (smtp.resend.com, user
# "resend", password = API key), Brevo, SendGrid (user "apikey").
# Port 587 uses STARTTLS; set SMTP_PORT=465 (or SMTP_SECURE="true") for implicit TLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Sender shown to customers. The domain must be verified with your provider.
EMAIL_FROM="Dartler <no-reply@dartler.com>"

# ---------------------------------------------------------------- analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/dartler_india/"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/DartlerEnterprise/"
# Floating WhatsApp chat button. Country code first, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER="917092018000"

# ---------------------------------------------------------------- seed
# Credentials created by `npm run db:seed`. Change before going live.
SEED_ADMIN_EMAIL="admin@dartler.com"
SEED_ADMIN_PASSWORD="Dartler@2026"
SEED_CUSTOMER_EMAIL="priya@example.com"
SEED_CUSTOMER_PASSWORD="Customer@2026"
